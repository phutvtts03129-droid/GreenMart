<%@ page pageEncoding="UTF-8" %>
<%-- ===================== KHUNG CHAT AI (Grok) + QUÉT VÙNG MÀN HÌNH ===================== --%>
<style>
/* ---------- Nút mở chat (góc phải, nằm trên nút lên đầu trang) ---------- */
#aiFab{position:fixed;right:22px;bottom:84px;width:60px;height:60px;border-radius:50%;border:0;z-index:2050;
  background:linear-gradient(135deg,var(--g700),var(--g500));color:#fff;font-size:1.6rem;
  box-shadow:0 10px 26px rgba(46,125,50,.45);transition:transform .25s,box-shadow .25s}
#aiFab:hover{transform:scale(1.08);box-shadow:0 14px 32px rgba(46,125,50,.55)}
#aiFab .ai-ping{position:absolute;top:2px;right:2px;width:14px;height:14px;border-radius:50%;background:var(--orange);border:2px solid #fff}
#aiFab .ai-ping::after{content:"";position:absolute;inset:-2px;border-radius:50%;border:2px solid var(--orange);animation:aiPing 2s infinite}
@keyframes aiPing{to{transform:scale(2.2);opacity:0}}
#aiChat.open #aiFab{display:none}

/* ---------- Khung chat ---------- */
#aiPanel{position:fixed;right:22px;bottom:22px;width:392px;height:min(640px,calc(100vh - 44px));z-index:2060;
  display:flex;flex-direction:column;overflow:hidden;border-radius:24px;
  background:var(--card);border:1px solid var(--line);color:var(--text);
  box-shadow:0 24px 60px rgba(0,0,0,.32);backdrop-filter:blur(14px);
  opacity:0;visibility:hidden;transform:translateY(24px) scale(.97);transform-origin:bottom right;
  transition:opacity .28s,transform .28s,visibility .28s}
#aiChat.open #aiPanel{opacity:1;visibility:visible;transform:none}
#aiPanel header{display:flex;align-items:center;gap:12px;padding:14px 14px 14px 16px;color:#fff;
  background:linear-gradient(120deg,var(--g800),var(--g500))}
.ai-av{width:42px;height:42px;border-radius:14px;background:rgba(255,255,255,.2);display:grid;place-items:center;font-size:1.4rem;flex-shrink:0}
.ai-ht{flex:1;min-width:0;line-height:1.25}
.ai-ht b{display:block;font-size:.98rem}
.ai-ht small{opacity:.9;font-size:.74rem;display:flex;align-items:center;gap:6px}
.ai-ht small::before{content:"";width:8px;height:8px;border-radius:50%;background:#7CFF8F;box-shadow:0 0 8px #7CFF8F}
#aiPanel header button{width:34px;height:34px;border-radius:10px;border:0;background:rgba(255,255,255,.16);color:#fff;transition:.2s}
#aiPanel header button:hover{background:rgba(255,255,255,.32)}

#aiMsgs{flex:1;overflow-y:auto;padding:16px 14px;display:flex;flex-direction:column;gap:12px;background:var(--bg2);scroll-behavior:smooth}
.ai-m{max-width:86%;padding:10px 14px;border-radius:18px;font-size:.92rem;line-height:1.55;word-wrap:break-word;overflow-wrap:anywhere;animation:aiIn .25s ease-out}
@keyframes aiIn{from{opacity:0;transform:translateY(8px)}}
.ai-m.bot{align-self:flex-start;background:var(--card);border:1px solid var(--line);border-bottom-left-radius:6px}
.ai-m.user{align-self:flex-end;color:#fff;background:linear-gradient(135deg,var(--g700),var(--g500));border-bottom-right-radius:6px}
.ai-m.err{border-color:#e53935;color:#c62828}
[data-theme="dark"] .ai-m.err{color:#ff8a80}
.ai-m img{display:block;max-width:100%;max-height:170px;border-radius:12px;margin-bottom:8px;border:2px solid rgba(255,255,255,.65);cursor:zoom-in}
.ai-m.bot img{border-color:var(--line)}
.ai-typing{display:inline-flex;gap:5px;padding:4px 0}
.ai-typing i{width:8px;height:8px;border-radius:50%;background:var(--g500);animation:aiDot 1.1s infinite}
.ai-typing i:nth-child(2){animation-delay:.18s}.ai-typing i:nth-child(3){animation-delay:.36s}
@keyframes aiDot{0%,60%,100%{transform:translateY(0);opacity:.4}30%{transform:translateY(-6px);opacity:1}}

#aiChips{display:flex;gap:8px;overflow-x:auto;padding:10px 14px 4px;background:var(--bg2);scrollbar-width:none}
#aiChips::-webkit-scrollbar{display:none}
#aiChips button{flex-shrink:0;border:1px solid var(--g500);background:var(--card);color:var(--g700);border-radius:50px;padding:6px 14px;font-size:.8rem;font-weight:600;transition:.2s}
#aiChips button:hover{background:var(--g700);color:#fff}

#aiPrev{display:none;align-items:center;gap:10px;padding:8px 14px;background:var(--bg2);border-top:1px dashed var(--line)}
#aiPrev.show{display:flex}
#aiPrev img{height:46px;max-width:90px;object-fit:cover;border-radius:10px;border:2px solid var(--g500)}
#aiPrev span{flex:1;font-size:.8rem;color:var(--muted)}
#aiPrev button{border:0;background:transparent;color:var(--muted);font-size:1.1rem}
#aiPrev button:hover{color:#e53935}

.ai-input{display:flex;align-items:flex-end;gap:8px;padding:10px 12px 12px;background:var(--card);border-top:1px solid var(--line)}
.ai-input .ib{width:40px;height:40px;flex-shrink:0;border-radius:12px;border:0;background:var(--g100);color:var(--g700);font-size:1.1rem;transition:.2s}
.ai-input .ib:hover{background:var(--g700);color:#fff}
#aiText{flex:1;resize:none;max-height:110px;border:1px solid var(--line);border-radius:14px;padding:9px 13px;font:inherit;font-size:.92rem;background:var(--bg2);color:var(--text);outline:0;transition:border-color .2s}
#aiText:focus{border-color:var(--g500)}
#aiSend{width:42px;height:42px;flex-shrink:0;border-radius:50%;border:0;background:var(--orange);color:#fff;font-size:1.05rem;transition:.2s}
#aiSend:hover{background:#e56d00;transform:scale(1.06)}
#aiSend:disabled{opacity:.5;transform:none;cursor:not-allowed}
#aiPanel button:focus-visible,#aiFab:focus-visible,#aiText:focus-visible{outline:3px solid var(--orange);outline-offset:2px}

/* ---------- Lớp quét vùng màn hình ---------- */
#aiSel{position:fixed;inset:0;z-index:3000;cursor:crosshair;background:rgba(0,0,0,.38);touch-action:none;user-select:none}
#aiSel.drag{background:transparent}
#aiSel .hint{position:absolute;top:18px;left:50%;transform:translateX(-50%);background:#14532d;color:#fff;padding:10px 20px;border-radius:50px;font-size:.9rem;font-weight:600;box-shadow:0 8px 24px rgba(0,0,0,.35);white-space:nowrap;max-width:94vw;overflow:hidden;text-overflow:ellipsis}
#aiSel.drag .hint{opacity:0}
#aiSel .box{position:absolute;border:2px dashed #fff;outline:2px solid var(--orange);box-shadow:0 0 0 9999px rgba(0,0,0,.52);display:none}
#aiSel .size{position:absolute;right:0;bottom:-28px;background:var(--orange);color:#fff;font-size:.72rem;font-weight:700;padding:2px 8px;border-radius:8px}

/* ---------- Điện thoại: chiếm toàn màn hình ---------- */
@media(max-width:575px){
  #aiPanel{right:0;bottom:0;width:100%;height:100%;border-radius:0}
  #aiFab{right:16px;bottom:78px}
}
@media(prefers-reduced-motion:reduce){#aiPanel,.ai-m{transition:none;animation:none}#aiFab .ai-ping::after{animation:none}}
</style>

<div id="aiChat">
  <button id="aiFab" type="button" aria-label="Mở trợ lý AI"><i class="bi bi-chat-dots-fill"></i><span class="ai-ping"></span></button>

  <section id="aiPanel" aria-label="Trợ lý AI" aria-hidden="true">
    <header>
      <div class="ai-av"><i class="bi bi-robot"></i></div>
      <div class="ai-ht"><b>Trợ lý Nông Sản Xanh</b><small>Hỏi bằng chữ hoặc quét ảnh trên trang</small></div>
      <button id="aiClear" type="button" title="Cuộc trò chuyện mới" aria-label="Cuộc trò chuyện mới"><i class="bi bi-arrow-counterclockwise"></i></button>
      <button id="aiClose" type="button" title="Đóng" aria-label="Đóng"><i class="bi bi-x-lg"></i></button>
    </header>

    <div id="aiMsgs" aria-live="polite"></div>

    <div id="aiChips">
      <button type="button">Gợi ý thực đơn cho gia đình 4 người</button>
      <button type="button">Cách bảo quản rau xanh lâu hơn</button>
      <button type="button">Combo nào hợp cho bé ăn dặm?</button>
      <button type="button">Phí giao hàng tính thế nào?</button>
    </div>

    <div id="aiPrev"><img alt="Ảnh đã chọn"><span>Đã chọn vùng ảnh. Nhập câu hỏi rồi gửi.</span><button type="button" id="aiPrevX" aria-label="Bỏ ảnh"><i class="bi bi-x-circle-fill"></i></button></div>

    <div class="ai-input">
      <button class="ib" id="aiScan" type="button" title="Kéo chọn vùng trên màn hình để hỏi" aria-label="Quét vùng màn hình"><i class="bi bi-crop"></i></button>
      <button class="ib" id="aiUp" type="button" title="Tải ảnh lên" aria-label="Tải ảnh lên"><i class="bi bi-image"></i></button>
      <input type="file" id="aiFile" accept="image/*" hidden>
      <textarea id="aiText" rows="1" maxlength="2000" placeholder="Nhập câu hỏi..."></textarea>
      <button id="aiSend" type="button" aria-label="Gửi"><i class="bi bi-send-fill"></i></button>
    </div>
  </section>
</div>

<script>
(function(){
  var ENDPOINT = '${pageContext.request.contextPath}/chat-ai';
  var H2C_URL  = 'https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js';
  var MAX_SIDE = 1280;   // cạnh dài nhất của ảnh gửi đi (px)

  var $ = function(id){ return document.getElementById(id); };
  var chat=$('aiChat'), fab=$('aiFab'), msgs=$('aiMsgs'), txt=$('aiText'), sendBtn=$('aiSend');
  var prev=$('aiPrev'), prevImg=prev.querySelector('img'), chips=$('aiChips');
  var attached=null, busy=false, history=[];

  function say(m){ if(window.toast) window.toast(m); }

  /* ---------- mở / đóng ---------- */
  function openChat(){ chat.classList.add('open'); $('aiPanel').setAttribute('aria-hidden','false'); setTimeout(function(){txt.focus();},300); }
  function closeChat(){ chat.classList.remove('open'); $('aiPanel').setAttribute('aria-hidden','true'); }
  fab.addEventListener('click',openChat);
  $('aiClose').addEventListener('click',closeChat);

  /* ---------- hiển thị tin nhắn ---------- */
  function fmt(s){
    s=String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    s=s.replace(/\*\*(.+?)\*\*/g,'<b>$1</b>');
    s=s.replace(/^\s*[-*]\s+(.+)$/gm,'\u2022 $1');
    s=s.replace(/^#+\s*(.+)$/gm,'<b>$1</b>');
    return s.replace(/\n/g,'<br>');
  }
  function add(role,text,img,isErr){
    var d=document.createElement('div');
    d.className='ai-m '+role+(isErr?' err':'');
    if(img){ var im=document.createElement('img'); im.src=img; im.alt='Ảnh đã gửi'; im.addEventListener('click',function(){ window.open(img,'_blank'); }); d.appendChild(im); }
    var sp=document.createElement('div'); sp.innerHTML = fmt(text);
    d.appendChild(sp);
    msgs.appendChild(d); msgs.scrollTop=msgs.scrollHeight;
    return d;
  }
  function typing(){
    var d=document.createElement('div'); d.className='ai-m bot';
    d.innerHTML='<span class="ai-typing"><i></i><i></i><i></i></span>';
    msgs.appendChild(d); msgs.scrollTop=msgs.scrollHeight; return d;
  }
  function welcome(){
    msgs.innerHTML=''; history=[]; setAttach(null);
    add('bot','Xin chào! Mình là trợ lý của **Nông Sản Xanh**.\nBạn có thể hỏi trực tiếp, hoặc bấm nút cắt ảnh bên dưới để **kéo chọn một vùng trên trang** (sản phẩm, giá, combo...) rồi hỏi về vùng đó.');
    chips.style.display='';
  }
  $('aiClear').addEventListener('click',welcome);
  chips.querySelectorAll('button').forEach(function(b){ b.addEventListener('click',function(){ txt.value=b.textContent; send(); }); });

  /* ---------- ảnh đính kèm ---------- */
  function setAttach(url){
    attached=url;
    if(url){ prevImg.src=url; prev.classList.add('show'); } else { prev.classList.remove('show'); prevImg.removeAttribute('src'); }
  }
  $('aiPrevX').addEventListener('click',function(){ setAttach(null); });

  function toJpeg(src,w,h){
    var r=Math.min(1,MAX_SIDE/Math.max(w,h));
    var c=document.createElement('canvas'); c.width=Math.max(1,Math.round(w*r)); c.height=Math.max(1,Math.round(h*r));
    var g=c.getContext('2d'); g.fillStyle='#fff'; g.fillRect(0,0,c.width,c.height);
    g.drawImage(src,0,0,w,h,0,0,c.width,c.height);
    return c.toDataURL('image/jpeg',.85);
  }

  /* tải ảnh từ máy */
  $('aiUp').addEventListener('click',function(){ $('aiFile').click(); });
  $('aiFile').addEventListener('change',function(){
    var f=this.files[0]; this.value='';
    if(!f) return;
    if(!/^image\//.test(f.type)){ say('Vui lòng chọn file ảnh'); return; }
    var url=URL.createObjectURL(f), im=new Image();
    im.onload=function(){ setAttach(toJpeg(im,im.naturalWidth,im.naturalHeight)); URL.revokeObjectURL(url); txt.focus(); };
    im.onerror=function(){ say('Không đọc được ảnh'); };
    im.src=url;
  });

  /* dán ảnh (Ctrl+V) vào ô nhập */
  txt.addEventListener('paste',function(e){
    var items=(e.clipboardData||{}).items||[];
    for(var i=0;i<items.length;i++){
      if(items[i].type.indexOf('image')===0){
        var f=items[i].getAsFile(), url=URL.createObjectURL(f), im=new Image();
        im.onload=function(){ setAttach(toJpeg(im,im.naturalWidth,im.naturalHeight)); URL.revokeObjectURL(url); };
        im.src=url; e.preventDefault(); return;
      }
    }
  });

  /* ---------- QUÉT VÙNG MÀN HÌNH ---------- */
  var h2cPromise=null;
  function loadH2C(){
    if(window.html2canvas) return Promise.resolve();
    if(h2cPromise) return h2cPromise;
    h2cPromise=new Promise(function(ok,fail){
      var s=document.createElement('script'); s.src=H2C_URL;
      s.onload=ok; s.onerror=function(){ h2cPromise=null; fail(new Error('Không tải được thư viện quét ảnh')); };
      document.head.appendChild(s);
    });
    return h2cPromise;
  }

  function startScan(){
    loadH2C().catch(function(){});            // tải sẵn trong lúc người dùng đang kéo chọn
    
    closeChat();

    var ov=document.createElement('div'); ov.id='aiSel';
    ov.innerHTML='<div class="hint">Kéo chuột (hoặc ngón tay) để chọn vùng cần hỏi. Nhấn Esc để hủy.</div><div class="box"><span class="size"></span></div>';
    document.body.appendChild(ov);
    var box=ov.querySelector('.box'), size=ov.querySelector('.size');
    var sx=0, sy=0, drawing=false, rect=null;

    function cleanup(){ document.removeEventListener('keydown',onKey,true); if(ov.parentNode) ov.parentNode.removeChild(ov); }
    function cancel(){ cleanup(); openChat(); }
    function onKey(e){ if(e.key==='Escape'){ e.preventDefault(); cancel(); } }
    document.addEventListener('keydown',onKey,true);
    ov.addEventListener('contextmenu',function(e){ e.preventDefault(); cancel(); });

    ov.addEventListener('pointerdown',function(e){
      if(e.button>0) return;
      drawing=true; sx=e.clientX; sy=e.clientY; rect=null;
      ov.classList.add('drag'); box.style.display='block';
      ov.setPointerCapture(e.pointerId); e.preventDefault();
    });
    ov.addEventListener('pointermove',function(e){
      if(!drawing) return;
      var x=Math.min(sx,e.clientX), y=Math.min(sy,e.clientY), w=Math.abs(e.clientX-sx), h=Math.abs(e.clientY-sy);
      rect={x:x,y:y,w:w,h:h};
      box.style.left=x+'px'; box.style.top=y+'px'; box.style.width=w+'px'; box.style.height=h+'px';
      size.textContent=Math.round(w)+' × '+Math.round(h);
    });
    ov.addEventListener('pointerup',function(e){
      if(!drawing) return; drawing=false;
      if(!rect || rect.w<16 || rect.h<16){ say('Vùng chọn quá nhỏ, hãy kéo lại'); cancel(); return; }
      capture(rect,cleanup);
    });
  }

  function capture(r,cleanup){
    say('Đang quét vùng đã chọn...');
    cleanup();
    loadH2C().then(function(){
      // chờ trình duyệt vẽ lại sau khi gỡ lớp chọn
      return new Promise(function(res){ requestAnimationFrame(function(){ requestAnimationFrame(res); }); });
    }).then(function(){
      var dark=document.documentElement.getAttribute('data-theme')==='dark';
      var scale=Math.min(window.devicePixelRatio||1,2);
      return window.html2canvas(document.documentElement,{
        x:window.scrollX, y:window.scrollY, width:window.innerWidth, height:window.innerHeight,
        scale:scale, useCORS:true, logging:false,
        backgroundColor: dark ? '#040b18' : '#fbfdf6',
        ignoreElements:function(el){ return el.id==='aiChat'||el.id==='aiSel'; }
      }).then(function(full){
        var k=full.width/window.innerWidth;
        var sxp=Math.round(r.x*k), syp=Math.round(r.y*k), sw=Math.round(r.w*k), sh=Math.round(r.h*k);
        var crop=document.createElement('canvas'); crop.width=sw; crop.height=sh;
        crop.getContext('2d').drawImage(full,sxp,syp,sw,sh,0,0,sw,sh);
        setAttach(toJpeg(crop,sw,sh));
        openChat();
        say('Đã quét xong, hãy nhập câu hỏi');
      });
    }).catch(function(err){
      console.error(err); openChat();
      add('bot','Không quét được vùng này (có thể do ảnh hoặc video từ trang khác chặn). Bạn thử chọn vùng khác, hoặc dùng nút tải ảnh lên nhé.',null,true);
    });
  }
  $('aiScan').addEventListener('click',startScan);

  /* ---------- gửi câu hỏi ---------- */
  function send(){
    if(busy) return;
    var q=txt.value.trim(), img=attached;
    if(!q && !img) return;
    var shown = q || 'Hãy mô tả và giải thích vùng ảnh này.';

    add('user',shown,img);
    txt.value=''; txt.style.height='auto'; setAttach(null); chips.style.display='none';
    busy=true; sendBtn.disabled=true;
    var t=typing();

    fetch(ENDPOINT,{
      method:'POST',
      headers:{'Content-Type':'application/json; charset=UTF-8'},
      body:JSON.stringify({message:q, image:img||'', history:history.slice(-10)})
    }).then(function(r){ return r.json().catch(function(){ return {error:'Phản hồi không hợp lệ từ máy chủ.'}; }); })
    .then(function(data){
      t.remove();
      if(data.reply){
        add('bot',data.reply);
        history.push({role:'user',content: img ? shown+' (kèm 1 ảnh chụp từ trang web)' : shown});
        history.push({role:'assistant',content:data.reply});
      } else {
        add('bot',data.error||'Có lỗi xảy ra, bạn thử lại nhé.',null,true);
      }
    }).catch(function(){
      t.remove(); add('bot','Không kết nối được máy chủ. Bạn kiểm tra mạng rồi thử lại nhé.',null,true);
    }).then(function(){ busy=false; sendBtn.disabled=false; txt.focus(); });
  }
  sendBtn.addEventListener('click',send);
  txt.addEventListener('keydown',function(e){ if(e.key==='Enter' && !e.shiftKey){ e.preventDefault(); send(); } });
  txt.addEventListener('input',function(){ this.style.height='auto'; this.style.height=Math.min(this.scrollHeight,110)+'px'; });

  welcome();
})();
</script>
