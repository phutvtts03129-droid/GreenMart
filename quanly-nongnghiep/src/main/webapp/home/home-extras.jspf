<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%-- ===== home-extras.jspf =====
  Chèn dòng này NGAY TRƯỚC </body> (dòng cuối file trang chủ, KHÔNG để ở đầu file):
      <%@ include file="home-extras.jspf" %>
  Cần: trang chủ đã khai báo taglib "c" (đã có sẵn).
  Quyền lấy từ session attribute "currentUser" (do AuthServlet lưu). --%>
<%@ taglib prefix="fn" uri="http://java.sun.com/jsp/jstl/functions" %>
<c:set var="cp" value="${pageContext.request.contextPath}"/>
<c:set var="me" value="${not empty sessionScope.currentUser ? sessionScope.currentUser : sessionScope.user}"/>
<c:set var="role" value="${empty me ? 'GUEST' : fn:toUpperCase(empty me.role ? 'CUSTOMER' : me.role)}"/>

<%-- Dữ liệu phân quyền: chỉ vai trò nào thấy link của vai trò đó. Sửa URL cho đúng servlet của bạn. --%>
<div id="authData" hidden data-role="${role}" data-name="<c:out value='${me.fullname}'/>" data-ctx="${cp}">
  <c:choose>
    <c:when test="${role eq 'ADMIN'}">
      <a href="${cp}/admin" data-i="speedometer2">Bảng điều khiển</a>
      <a href="${cp}/admin/san-pham" data-i="basket3">Quản lý sản phẩm</a>
      <a href="${cp}/admin/don-hang" data-i="receipt">Quản lý đơn hàng</a>
      <a href="${cp}/admin/nguoi-dung" data-i="people">Quản lý người dùng</a>
      <a href="${cp}/admin/nhan-vien" data-i="person-badge">Nhân viên &amp; lương</a>
      <a href="${cp}/admin/bao-cao" data-i="graph-up-arrow">Báo cáo doanh thu</a>
    </c:when>
    <c:when test="${role eq 'EMPLOYEE'}">
      <a href="${cp}/nhan-vien" data-i="briefcase">Khu làm việc</a>
      <a href="${cp}/nhan-vien/don-hang" data-i="receipt">Xử lý đơn hàng</a>
      <a href="${cp}/nhan-vien/kho" data-i="box-seam">Quản lý kho</a>
      <a href="${cp}/nhan-vien/luong" data-i="cash-coin">Bảng lương của tôi</a>
    </c:when>
    <c:when test="${role eq 'GUEST'}"></c:when>
    <c:otherwise>
      <a href="${cp}/tai-khoan" data-i="person-circle">Hồ sơ của tôi</a>
      <a href="${cp}/don-hang-cua-toi" data-i="bag-check">Đơn hàng của tôi</a>
      <a href="${cp}/gio-hang" data-i="cart3">Giỏ hàng</a>
      <a href="#san-pham" data-i="heart">Sản phẩm yêu thích</a>
    </c:otherwise>
  </c:choose>
</div>

<!-- Ánh trăng + hai bên trang -->
<div class="moonlight"></div>

<aside class="rail rail-l" aria-label="Tiện ích">
  <div class="rc"><h6>📈 Giá nông sản hôm nay</h6>
    <ul class="pl">
      <li><span>🍅 Cà chua</span><b>35.000₫</b><i class="up">▲2%</i></li>
      <li><span>🥬 Xà lách</span><b>28.000₫</b><i class="dn">▼1%</i></li>
      <li><span>🥕 Cà rốt</span><b>30.000₫</b><i class="dn">▼3%</i></li>
      <li><span>🥦 Súp lơ</span><b>35.000₫</b><i class="up">▲1%</i></li>
      <li><span>🥑 Bơ sáp</span><b>62.000₫</b><i class="up">▲4%</i></li>
    </ul><small class="text-muted">Giá tham khảo / kg</small></div>
  <div class="rc"><h6>🌤️ Đang vào mùa tháng 11</h6>
    <div class="ch"><span>Bưởi</span><span>Cam sành</span><span>Su hào</span><span>Bắp cải</span><span>Hồng giòn</span><span>Quýt</span></div></div>
  <div class="rc"><h6>💡 Mẹo nhà bếp</h6><p id="tipTxt" class="small mb-0"></p></div>
</aside>

<aside class="rail rail-r" aria-label="Ưu đãi">
  <div class="rc vc"><small>MÃ GIẢM 10% ĐƠN ĐẦU</small><div class="code">NONGSAN10</div>
    <button type="button" id="copyCode">Sao chép mã</button></div>
  <div class="rc cm"><img src="https://images.unsplash.com/photo-1610832958506-aa56368176cf?w=500" alt="" onerror="this.style.display='none'">
    <b>Combo rau củ gia đình</b><small class="text-muted d-block mb-2">Giảm 25% hôm nay</small>
    <a class="btn-pay d-block py-2" href="#combo">Xem combo</a></div>
  <div class="rc"><h6>🔔 Vừa đặt hàng</h6><div id="buyer" class="by"></div></div>
</aside>

<style>
/* ---- Menu theo quyền ---- */
.um-btn{display:flex;align-items:center;gap:8px;border:2px solid var(--g700);background:transparent;color:var(--text);border-radius:50px;padding:4px 12px 4px 4px;font-weight:600;font-size:.85rem}
.um-btn .av{width:34px;height:34px;border-radius:50%;display:grid;place-items:center;color:#fff;font-weight:800;background:var(--rc,#2e7d32)}
.um-btn .nm{line-height:1.1;text-align:left;max-width:130px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.um-btn small{display:block;font-size:.68rem;color:var(--rc,#2e7d32);font-weight:700}
.um-menu{min-width:250px;border-radius:18px;border:1px solid var(--line);background:var(--card);padding:8px;box-shadow:0 16px 40px var(--shadow)}
.um-menu .dropdown-item{border-radius:10px;font-size:.9rem;padding:8px 12px;color:var(--text)}
.um-menu .dropdown-item:hover{background:var(--g100);color:var(--g700)}
.um-head{padding:8px 12px 10px;display:flex;justify-content:space-between;align-items:center;gap:8px;border-bottom:1px dashed var(--line);margin-bottom:6px}
.um-head .rl{font-size:.68rem;font-weight:800;color:#fff;background:var(--rc,#2e7d32);padding:3px 10px;border-radius:50px}
.um-head.m{color:#fff;border-color:rgba(255,255,255,.2)}

/* ---- Hai bên trang (màn hình rộng ≥1700px, hiện khi cuộn qua banner) ---- */
/* ---- Hai bên trang (màn hình rộng ≥1700px, hiện khi cuộn qua banner) ---- */
/* ---- Hai bên trang: Tự động bám sát lề trái/phải, không đè nội dung giữa ---- */
/* ---- Hai bên trang: Canh chuẩn đồng bộ cả 2 bên ---- */
.rail {
  position: fixed !important;
  top: 130px !important;            /* Đồng bộ cố định khoảng cách từ mép trên */
  width: 250px;
  display: none;
  flex-direction: column;
  gap: 12px;
  z-index: 100;                     /* Đưa lên trên để không bị che khuất */
  max-height: calc(100vh - 150px);
  overflow-y: auto;
  scrollbar-width: none;
  opacity: 0;
  pointer-events: none;
  transition: opacity .5s ease, transform .5s ease;
}
.rail::-webkit-scrollbar { display: none; }

/* Bên trái: cố định sát lề trái */
.rail-l {
  left: 20px !important;
  right: auto !important;
  transform: translateY(20px);      /* Trượt nhẹ từ dưới lên thay vì trượt ngang */
}

/* Bên phải: cố định sát lề phải */
.rail-r {
  right: 20px !important;
  left: auto !important;
  transform: translateY(20px);
}

/* Khi cuộn trang đạt điều kiện hiện ra */
body.rails-on .rail {
  opacity: 1 !important;
  transform: translateY(0) !important;
  pointer-events: auto !important;
}

/* Màn hình từ 1600px trở lên mới hiển thị */
@media (min-width: 1600px) {
  .rail {
    display: flex;
  }
}
body.rails-on .rail{opacity:1;transform:none;pointer-events:auto}
.rc{background:var(--card);border:1px solid var(--line);border-radius:20px;padding:14px 16px;box-shadow:0 10px 26px var(--shadow);backdrop-filter:blur(10px);color:var(--text)}
.rc h6{font-size:.85rem;font-weight:800;color:var(--head);margin-bottom:10px}
.pl{list-style:none;padding:0;margin:0 0 6px}
.pl li{display:flex;align-items:center;gap:6px;font-size:.8rem;padding:6px 0;border-bottom:1px dashed var(--line)}
.pl b{margin-left:auto}.pl i{font-style:normal;font-size:.7rem;font-weight:700}.up{color:#e53935}.dn{color:#2e9e4f}
.ch span{display:inline-block;margin:0 4px 6px 0;padding:4px 10px;border-radius:50px;background:var(--g100);color:var(--g700);font-size:.78rem;font-weight:600}
.vc{background:linear-gradient(135deg,#ff7a00,#ff4d00);color:#fff;border:0;text-align:center}
.vc .code{font-size:1.5rem;font-weight:800;letter-spacing:.08em;margin:6px 0 10px;border:2px dashed rgba(255,255,255,.7);border-radius:12px;padding:6px}
.vc button{border:0;background:#fff;color:#e65100;font-weight:700;border-radius:50px;padding:7px 18px;font-size:.82rem}
.cm img{width:100%;height:110px;object-fit:cover;border-radius:14px;margin-bottom:10px}
.by{font-size:.82rem;min-height:44px;transition:opacity .4s}

/* ---- Bóng đèn thay nút sáng/tối ---- */
.theme-btn{display:none!important}
.fx-dock{flex-direction:row!important;align-items:flex-end!important;gap:8px!important}
.fx-panel{margin-bottom:8px}
@media(max-width:600px){.fx-dock{flex-direction:column-reverse!important;align-items:flex-start!important}}
.lm{width:96px;cursor:pointer;touch-action:none;user-select:none}
.lm svg{width:100%;overflow:visible;display:block}
.lm .sh-on{transition:opacity .6s}[data-theme="dark"] .lm .sh-on{opacity:0}
.lm .wp{color:#a06d28;transition:color .6s}[data-theme="dark"] .lm .wp{color:#5f574d}
.lm .shw{filter:drop-shadow(0 0 10px rgba(255,190,70,.8));transition:filter .6s}[data-theme="dark"] .lm .shw{filter:none}
.lm .chain{stroke:#d9c9a3;stroke-width:2;stroke-dasharray:1 4;stroke-linecap:round}
.lm .handle{cursor:grab}.lm:focus-visible{outline:2px solid var(--g700);border-radius:12px}

/* ---- Mặt trăng góc banner + ánh trăng ---- */
/* ---- Mặt trăng góc banner + hiệu ứng phát sáng ---- */
[data-theme="dark"] .hero::before { display: none; }
[data-theme="dark"] .hero-clock { top: 140px; }

.moon {
  position: absolute;
  top: 22px;
  right: 48px;
  z-index: 4;
  width: 110px;
  height: 110px;
  border-radius: 50%;
  pointer-events: none;
  background: radial-gradient(circle at 35% 32%, #fffef0 0%, #ffeaa8 45%, #eec45c 75%, #cca03c 100%);
  box-shadow: 0 0 35px 10px rgba(255, 226, 140, 0.45), 0 0 90px 40px rgba(255, 214, 120, 0.2);
  opacity: 0;
  transform: translateY(40px) scale(0.7);
  transition: opacity 1.2s ease, transform 1.5s cubic-bezier(0.2, 0.8, 0.2, 1);
}

.moon::before {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: 50%;
  background: 
    radial-gradient(circle at 62% 38%, rgba(180, 140, 50, 0.28) 0 9px, transparent 10px),
    radial-gradient(circle at 36% 62%, rgba(180, 140, 50, 0.22) 0 13px, transparent 14px),
    radial-gradient(circle at 70% 70%, rgba(180, 140, 50, 0.2) 0 6px, transparent 7px);
}

[data-theme="dark"] .moon {
  opacity: 1;
  transform: none;
  animation: moonGlow 6s ease-in-out infinite;
}

@keyframes moonGlow {
  0%, 100% {
    box-shadow: 0 0 35px 10px rgba(255, 226, 140, 0.4), 0 0 90px 40px rgba(255, 214, 120, 0.18);
  }
  50% {
    box-shadow: 0 0 50px 18px rgba(255, 226, 140, 0.55), 0 0 120px 60px rgba(255, 214, 120, 0.25);
  }
}

/* ---- Ánh trăng phủ mềm nửa màn hình bên phải ---- */
.moonlight {
  position: fixed;
  top: 0;
  right: 0;
  width: 1000vw;
  height: 100vh;
  pointer-events: none;
  z-index: 5;
  mix-blend-mode: screen;
  background: radial-gradient(
    circle at 90% 12%,
    rgba(255, 230, 150, 0.25) 0%,
    rgba(255, 215, 120, 0.14) 35%,
    rgba(255, 200, 100, 0.05) 60%,
    transparent 80%
  );
  opacity: 0;
  transition: opacity 1.4s ease-in-out;
}

[data-theme="dark"] .moonlight {
  opacity: 1;
}

/* Tia sáng lan tỏa mờ dịu mắt */
.moonlight::after {
  content: "";
  position: absolute;
  inset: 0;
  background: repeating-conic-gradient(
    from 175deg at 90% 12%,
    rgba(255, 240, 180, 0.04) 0deg 8deg,
    transparent 8deg 20deg
  );
  -webkit-mask-image: radial-gradient(circle at 90% 12%, #000 10%, transparent 75%);
  mask-image: radial-gradient(circle at 90% 12%, #000 10%, transparent 75%);
  filter: blur(5px);
}

/* Responsive cho mobile / tablet */
@media (max-width: 991px) {
  .moon {
    width: 72px;
    height: 72px;
    right: 20px;
    top: 18px;
  }
  [data-theme="dark"] .hero-clock {
    top: 110px;
  }
  .moonlight {
    width: 80vw;
  }
}
/* ---- Ánh trăng phủ góc + nền đêm dịu hơn ---- */
[data-theme="dark"]{--bg:#081428;--bg2:#0c1b36;--card:rgba(16,32,60,.72)}
[data-theme="dark"] body{background:radial-gradient(900px 640px at 100% 0,rgba(255,200,110,.22),transparent 62%),radial-gradient(1200px 700px at 80% -10%,#14396f 0,transparent 62%),radial-gradient(900px 600px at 0 45%,#2b1a3a 0,transparent 58%),#081428}
[data-theme="dark"] .hero::after{background:linear-gradient(100deg,rgba(6,16,40,.66),rgba(6,16,40,.34) 60%,rgba(40,30,10,.06))}
[data-theme="dark"] .hero-clock{top:190px}
.moon{width:140px;height:140px;top:20px;right:56px;box-shadow:0 0 50px 20px rgba(255,226,140,.5),0 0 160px 80px rgba(255,214,120,.3)}
@keyframes moonGlow{50%{box-shadow:0 0 70px 30px rgba(255,226,140,.62),0 0 220px 110px rgba(255,214,120,.36)}}
.moonlight{width:min(100vw,1200px);height:min(100vh,900px);z-index:1031;mix-blend-mode:screen;
  background:radial-gradient(ellipse 70% 80% at 100% 0,rgba(255,214,120,.42) 0,rgba(255,200,100,.24) 28%,rgba(255,190,90,.1) 52%,transparent 75%)}
.moonlight::after{content:"";position:absolute;inset:0;
  background:repeating-conic-gradient(from 180deg at 100% 0,rgba(255,230,160,.10) 0 6deg,transparent 6deg 16deg);
  -webkit-mask-image:radial-gradient(ellipse 80% 90% at 100% 0,#000,transparent 70%);mask-image:radial-gradient(ellipse 80% 90% at 100% 0,#000,transparent 70%)}
@media(max-width:991px){.moon{width:84px;height:84px;right:16px;top:16px}[data-theme="dark"] .hero-clock{top:120px}}
</style>

<script>
document.addEventListener('DOMContentLoaded',function(){
var $=function(s,c){return(c||document).querySelector(s)},root=document.documentElement;

/* ===== Phân luồng theo quyền ===== */
var d=$('#authData');
if(d&&d.dataset.role!=='GUEST'){
  var role=d.dataset.role,ctx=d.dataset.ctx||'',name=d.dataset.name||'Tài khoản';
  var map={ADMIN:['Quản trị viên','#e53935'],EMPLOYEE:['Nhân viên','#fb8c00']},R=map[role]||['Khách hàng','#2e7d32'];
  var links=[].slice.call(d.querySelectorAll('a'));
  var list=function(cls){return links.map(function(a){return '<a class="'+cls+'" href="'+a.getAttribute('href')+'"><i class="bi bi-'+a.dataset.i+' me-2"></i>'+a.textContent+'</a>'}).join('')};
  var out=function(cls){return '<a class="'+cls+'" href="'+ctx+'/logout"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</a>'};

  var first=$('.site-header .btn-auth');
  if(first){
    var w=document.createElement('div');w.className='dropdown um d-none d-md-block';w.style.setProperty('--rc',R[1]);
    w.innerHTML='<button class="um-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false"><span class="av"></span><span class="nm d-none d-xl-block"><b class="n"></b><small>'+R[0]+'</small></span><i class="bi bi-chevron-down"></i></button>'+
      '<div class="dropdown-menu dropdown-menu-end um-menu"><div class="um-head"><b class="n"></b><span class="rl">'+R[0]+'</span></div>'+list('dropdown-item')+'<div class="dropdown-divider"></div>'+out('dropdown-item text-danger')+'</div>';
    w.querySelector('.av').textContent=name.charAt(0).toUpperCase();
    w.querySelectorAll('.n').forEach(function(n){n.textContent=name});
    first.parentNode.insertBefore(w,first);
    document.querySelectorAll('.site-header .btn-auth').forEach(function(a){a.remove()});
  }
  var mb=$('#menuMobile .offcanvas-body .d-flex.gap-2.mt-4');
  if(mb){
    var m=document.createElement('div');m.className='mt-4';m.style.setProperty('--rc',R[1]);
    m.innerHTML='<div class="um-head m"><b class="n"></b><span class="rl">'+R[0]+'</span></div>'+list('m-link')+out('m-link text-warning');
    m.querySelector('.n').textContent=name;
    mb.parentNode.replaceChild(m,mb);
  }
}

/* ===== Hai bên trang ===== */
var hero=$('#top');
if(hero&&'IntersectionObserver' in window)new IntersectionObserver(function(e){document.body.classList.toggle('rails-on',!e[0].isIntersecting)},{threshold:.15}).observe(hero);
var tips=['Rau lá nên rửa dưới vòi nước chảy, không ngâm lâu để giữ vitamin.','Bọc cuống rau bằng khăn giấy ẩm giúp rau giòn lâu hơn trong tủ lạnh.','Cà chua chín nên để ngoài, chỉ cho vào tủ lạnh khi đã chín hẳn.','Ngâm rau củ với nước muối loãng 10 phút để làm sạch hơn.'];
var buyers=['Chị Hà vừa mua Cà chua Cherry · 2 phút trước','Anh Quân vừa đặt Combo gia đình · 5 phút trước','Cô Lan vừa mua Bơ sáp 034 · 9 phút trước','Bạn Mai vừa đặt Combo eat-clean · 12 phút trước'];
var tipEl=$('#tipTxt'),byEl=$('#buyer'),ti=0;
function rot(){if(tipEl)tipEl.textContent=tips[ti%tips.length];if(byEl){byEl.style.opacity=0;setTimeout(function(){byEl.textContent=buyers[ti%buyers.length];byEl.style.opacity=1},400)}ti++}
rot();setInterval(rot,4500);
var cc=$('#copyCode');
if(cc)cc.addEventListener('click',function(){try{navigator.clipboard.writeText('NONGSAN10')}catch(e){}if(window.toast)toast('Đã sao chép mã NONGSAN10')});

/* ===== Bóng đèn thay nút sáng/tối (sáng = đèn bật, tối = đèn tắt + mặt trăng) ===== */
var dock=$('.fx-dock');
if(dock){
  var lm=document.createElement('div');lm.className='lm';lm.tabIndex=0;lm.setAttribute('role','button');lm.title='Kéo dây đèn để đổi sáng / tối';
  lm.innerHTML='<svg viewBox="0 0 110 160" aria-hidden="true"><defs>'+
    '<linearGradient id="lmOn" x1="0" x2="1"><stop offset="0" stop-color="#f1c056"/><stop offset=".5" stop-color="#fff7de"/><stop offset="1" stop-color="#eeb94f"/></linearGradient>'+
    '<linearGradient id="lmOff" x1="0" x2="1"><stop offset="0" stop-color="#85817a"/><stop offset=".5" stop-color="#d8d4c9"/><stop offset="1" stop-color="#7d7972"/></linearGradient>'+
    '<linearGradient id="lmCh" x1="0" x2="1"><stop offset="0" stop-color="#6f7b83"/><stop offset=".4" stop-color="#f2f5f6"/><stop offset="1" stop-color="#58646b"/></linearGradient>'+
    '<clipPath id="lmClip"><path d="M14 22 L14 100 A36 7 0 0 0 86 100 L86 22 A36 7 0 0 0 14 22Z"/></clipPath>'+
    '<g id="lmW"><path d="M0 0 C1 -16 -1 -32 2 -48" fill="none" stroke="currentColor" stroke-width="1.3"/><ellipse cx="-2" cy="-30" rx="1.6" ry="3.4" transform="rotate(-28 -2 -30)" fill="currentColor"/><ellipse cx="4" cy="-31" rx="1.6" ry="3.4" transform="rotate(28 4 -31)" fill="currentColor"/><ellipse cx="-1.5" cy="-38" rx="1.5" ry="3.2" transform="rotate(-26 -1.5 -38)" fill="currentColor"/><ellipse cx="4.5" cy="-39" rx="1.5" ry="3.2" transform="rotate(26 4.5 -39)" fill="currentColor"/><ellipse cx="2" cy="-48" rx="1.4" ry="3.4" fill="currentColor"/></g>'+
    '</defs>'+
    '<ellipse cx="50" cy="150" rx="30" ry="6" fill="#0f0906"/><rect x="20" y="140" width="60" height="10" fill="#2a1a12"/><ellipse cx="50" cy="140" rx="30" ry="6" fill="#3a251a" stroke="#6b4630" stroke-width=".8"/>'+
    '<rect x="46" y="104" width="8" height="38" fill="url(#lmCh)"/>'+
    '<g class="shw"><path d="M14 22 L14 100 A36 7 0 0 0 86 100 L86 22 A36 7 0 0 0 14 22Z" fill="url(#lmOff)"/>'+
    '<path class="sh-on" d="M14 22 L14 100 A36 7 0 0 0 86 100 L86 22 A36 7 0 0 0 14 22Z" fill="url(#lmOn)"/>'+
    '<g clip-path="url(#lmClip)"><use href="#lmW" class="wp" transform="translate(30 108) scale(1.2)"/><use href="#lmW" class="wp" transform="translate(48 110) scale(1.5)"/><use href="#lmW" class="wp" transform="translate(66 108) scale(1.1) rotate(6)"/></g>'+
    '<ellipse cx="50" cy="22" rx="36" ry="7" fill="#fff3c4" opacity=".55"/></g>'+
    '<line class="chain" id="lmChain" x1="93" y1="104" x2="93" y2="132"/>'+
    '<g class="handle" id="lmPull"><g id="lmTas"><circle cx="93" cy="136" r="3.4" fill="#d8b36e"/><path d="M89.5 139 L96.5 139 L95 152 Q93 155 91 152Z" fill="#c9a050"/></g><rect x="82" y="128" width="22" height="34" fill="transparent"/></g></svg>';
  dock.insertBefore(lm,dock.firstChild);

  var ch=$('#lmChain'),ta=$('#lmTas'),pl=$('#lmPull'),drag=false,sy=0,dy=0,moved=false;
  function setP(v){ch.setAttribute('y2',132+v);ta.setAttribute('transform','translate(0,'+v+')')}
  function flip(){if(window.setTheme)setTheme(root.getAttribute('data-theme')==='dark'?'light':'dark')}
  pl.addEventListener('pointerdown',function(e){drag=true;moved=false;sy=e.clientY;pl.setPointerCapture(e.pointerId);e.preventDefault();e.stopPropagation()});
  pl.addEventListener('pointermove',function(e){if(!drag)return;dy=Math.max(0,Math.min(26,e.clientY-sy));if(dy>3)moved=true;setP(dy)});
  function up(){if(!drag)return;drag=false;var ok=dy>14;setP(0);dy=0;if(ok)flip()}
  pl.addEventListener('pointerup',up);pl.addEventListener('pointercancel',up);
  lm.addEventListener('click',function(e){if(e.target.closest('#lmPull'))return;flip()});
  lm.addEventListener('keydown',function(e){if(e.key==='Enter'||e.key===' '){e.preventDefault();flip()}});
}

/* ===== Mặt trăng ở góc banner ===== */
if(hero){var mo=document.createElement('div');mo.className='moon';hero.appendChild(mo)}
});
</script>
